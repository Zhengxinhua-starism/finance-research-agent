# ============================================================
# 金融研报 Agent — 环境变量样例
# 使用方式：cp .env.example .env  然后填入真实值
# 注意：.env 必须加入 .gitignore，禁止提交
# ============================================================

# ---------------- DeepSeek（必填）----------------
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# quick 层：工具调用、数据获取、写作（便宜且支持 function calling）
QUICK_MODEL=deepseek-chat
# deep 层：仅评测 LLM-as-Judge（推理模型，不支持 function calling）
DEEP_MODEL=deepseek-reasoner
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=2.0
LLM_TEMPERATURE=0.0

# ---------------- Redis ----------------
# 本地开发：redis://localhost:6379/0
# docker-compose：redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=600
SESSION_TTL_SECONDS=3600
# true = Redis 连不上时降级为无缓存运行（不中断服务）
REDIS_OPTIONAL=true

# ---------------- Chroma 向量库 ----------------
CHROMA_PERSIST_DIR=data/knowledge_base
CHROMA_COLLECTION_NAME=finance_knowledge
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------- 混合检索参数 ----------------
BM25_TOP_K=20
VECTOR_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ---------------- Harness 运行时保护 ----------------
MAX_TURNS=10
TOOL_TIMEOUT_SECONDS=30
CONTEXT_MAX_TOKENS=8000
MAX_TOTAL_TOKENS=120000

# ---------------- 证据门禁容差 ----------------
NUMBER_TOLERANCE=0.05
RATIO_TOLERANCE_PP=0.5
GROWTH_TOLERANCE_PP=1.0
UNVERIFIED_RATIO_THRESHOLD=0.3
MAX_RETRIEVAL_ROUNDS=3

# ---------------- 数据源 ----------------
AKSHARE_TIMEOUT_SECONDS=30
DISK_CACHE_DIR=data/tool_cache
DISK_CACHE_TTL_SECONDS=86400
# 日 K 行情源优先级：腾讯/新浪直连（绕过系统代理），东财作最后兜底。
# 本机开了 HTTP_PROXY 时，东财 push2his 会被代理劫持；前两路不受影响。
PRICE_SOURCE_PRIORITY=tencent,sina,eastmoney
# 新闻检索：默认走免费的 AKShare 东财个股新闻接口。
# 只有当东财在时间窗内返回的条数少于 NEWS_MIN_RESULTS 时，
# 才调 Tavily 补充检索（按次计费），两路结果合并去重。
# 留空则不做补充检索，条数不足时如实返回并在 retrieval_notes 里说明。
TAVILY_API_KEY=
NEWS_MIN_RESULTS=3

# ---------------- 服务 ----------------
API_HOST=0.0.0.0
API_PORT=8000
TRACE_DIR=traces
LOG_LEVEL=INFO

# ---------------- 评测 ----------------
EVAL_TEST_CASES_PATH=eval/test_cases.json
EVAL_JUDGE_TIER=deep

# ---------------- HuggingFace 镜像（国内网络可选）----------------
# HF_ENDPOINT=https://hf-mirror.com
